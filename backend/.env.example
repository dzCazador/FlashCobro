# Backend example environment
PORT=3000
NODE_ENV=development
MP_WEBHOOK_SECRET=your_mercadopago_webhook_secret_here
MP_PUBLIC_KEY=APP_USR-your_public_key
MP_ACCESS_TOKEN=APP_USR-your_access_token
DATABASE_URL="mysql://user:password@localhost:3306/flashcobro"
# Polling de transferencias recibidas (opcional)
MP_POLL_INTERVAL_MS=10000
MP_POLL_WINDOW_SECONDS=120
MP_BACKFILL_HOURS=24
